# Local application data
DATABASE_PATH=data/local_ai_documenter.db
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=20971520

# Local embeddings (dimension is detected at runtime)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
# Leave blank until you evaluate a threshold on your own documents.
# RETRIEVAL_MIN_SCORE=0.35

# Remote Pinecone vector storage
PINECONE_API_KEY=
PINECONE_INDEX_NAME=local-ai-documenter
PINECONE_NAMESPACE=documents
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Local Ollama/Qwen
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# Local faster-whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Next.js server -> FastAPI
API_BASE_URL=http://localhost:8000

# Authentication (set true behind HTTPS in production)
AUTH_SESSION_DAYS=7
AUTH_COOKIE_SECURE=false
